# ==============================================================================
# ZeroTrust Shield — Frontend Environment Configuration Example
# ==============================================================================
# Copy this file to .env in the project root for local development.
# Never commit credentials, tokens, or private secrets to Git.

# Backend API Base URL
# - Local development (Express backend running on port 3001):
VITE_API_BASE_URL=http://localhost:3001

# - Deployed production behind Cloudflare Tunnel (Dedicated API Subdomain):
# VITE_API_BASE_URL=https://api.yourdomain.edu

# - Deployed production behind Cloudflare Tunnel (Unified Domain with /api path routing):
# VITE_API_BASE_URL=
