# ==============================================================================
# ZeroTrust Campus — Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# Never commit real credentials, tokens, private keys, or secrets to Git.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Cryptographic Secret for Local Development Signed Cookies (Min 32 characters)
SESSION_SECRET=replace_with_a_secure_random_session_secret_for_production

# ==============================================================================
# Cloudflare Zero Trust Access Configuration
# ==============================================================================
# Your Cloudflare Access team domain (e.g., your-team.cloudflareaccess.com or your-team)
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team-domain.cloudflareaccess.com

# Application Audience (AUD) Tag from Cloudflare Zero Trust Dashboard -> Access -> Applications
CLOUDFLARE_ACCESS_AUD=your-application-audience-tag-from-cloudflare-zero-trust

# Optional JWKS Certs URL override (defaults to https://<team>.cloudflareaccess.com/cdn-cgi/access/certs)
# CLOUDFLARE_ACCESS_CERTS_URL=https://your-team-domain.cloudflareaccess.com/cdn-cgi/access/certs

# Access Policy & Development Safeguards
# Set ALLOW_LOCAL_AUTH=true ONLY for offline local development without Cloudflare Tunnel.
# In production (NODE_ENV=production), local password login is automatically disabled,
# and Cloudflare Access assertion header (Cf-Access-Jwt-Assertion) is strictly required.
ALLOW_LOCAL_AUTH=true
CLOUDFLARE_ACCESS_ENFORCE=false

# Authorized Administrator Emails (comma-separated)
# Verified Cloudflare Access identities matching these emails are mapped to the Administrator role.
ADMIN_EMAILS=admin@zerotrustcampus.edu
